# Copier ce fichier vers .env et adapter les valeurs si necessaire

NODE_ENV=development
PORT=9090

# Base de donnees SQLite (fichier cree automatiquement)
DATABASE_URL="file:./data/prod.db"

# Secret utilise pour signer les tokens JWT - a changer en production
JWT_SECRET="remplacer-par-une-valeur-secrete-longue-et-aleatoire"
JWT_EXPIRES_IN="1d"

# Taille maximale du fichier importe (en octets), 5 Mo par defaut
MAX_UPLOAD_SIZE_BYTES=5242880
